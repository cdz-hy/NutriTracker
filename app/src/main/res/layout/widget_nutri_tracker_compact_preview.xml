<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_calories_remaining"
        android:textColor="#5C6475"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_calorie_value"
        android:textColor="#415F91"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="42"
        android:progressDrawable="@drawable/widget_preview_progress_calorie" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_card_inner"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:text="@string/widget_preview_compact_macros"
        android:textColor="#3B4252"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_water"
        android:textColor="#1E2430"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_preview_progress_water" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_chip_secondary"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/widget_preview_add_water"
            android:textColor="#0B577B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_chip_primary"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/widget_preview_scan_short"
            android:textColor="#1D3A6D"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
